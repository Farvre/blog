---
// 全局布局：所有页面共用
import { siteConfig } from '../site.config';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '我的博客' } = Astro.props;
const siteTitle = siteConfig.siteTitle;

const nav = [
  { href: '/', label: '首页' },
  { href: '/essays/', label: '随笔' },
  { href: '/journal/', label: '事记' },
  { href: '/memo/', label: 'memo' },
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path === '' : path.startsWith(href);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · {siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 字体：英文 Google Sans，中文思源黑体（正文）/ 思源宋体（标题）
         若 Google 字体加载失败，onerror 自动切换国内镜像 fonts.loli.net -->
    <link
      id="font-css"
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400..700&family=Noto+Sans+SC:wght@300..700&display=swap"
      onerror="this.onerror=null;this.href='https://fonts.loli.net/css2?family=Google+Sans:wght@400..700&family=Noto+Sans+SC:wght@300..700&display=swap';"
    />
    <link rel="stylesheet" href="/global.css" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <nav class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-text">{siteTitle}</span>
        </a>
        <div class="nav-links">
          {nav.map((item) => (
            <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
              {item.label}
            </a>
          ))}
        </div>
        <div class="nav-search">
          <input
            id="nav-search-input"
            type="search"
            placeholder="搜索…"
            aria-label="搜索文章"
            autocomplete="off"
          />
          <div id="nav-search-results" class="search-results" hidden></div>
        </div>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} {siteTitle} · Powered by Astro · Hosted on Netlify</p>
      </div>
    </footer>
    <script>
      // 导航栏搜索：读取构建时生成的 /search.json，边打字边出结果
      const input = document.getElementById('nav-search-input') as HTMLInputElement | null;
      const box = document.getElementById('nav-search-results') as HTMLDivElement | null;
      let index: { title: string; url: string; date: string; tags: string[]; text: string }[] | null = null;

      const esc = (s: string) =>
        s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

      async function getIndex() {
        if (!index) index = await (await fetch('/search.json')).json();
        return index;
      }

      input?.addEventListener('input', async () => {
        if (!box) return;
        const q = input.value.trim().toLowerCase();
        if (!q) { box.hidden = true; return; }
        const items = (await getIndex()).filter((x) =>
          (x.title + ' ' + x.tags.join(' ') + ' ' + x.text).toLowerCase().includes(q)
        ).slice(0, 6);
        box.innerHTML = items.length
          ? items.map((x) => `<a class="s-item" href="${x.url}"><span class="s-title">${esc(x.title)}</span><span class="s-meta">${x.date}</span></a>`).join('')
          : '<div class="s-empty">没有找到相关文章</div>';
        box.hidden = false;
      });

      input?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const first = box?.querySelector('a');
          if (first) location.href = first.getAttribute('href')!;
        }
        if (e.key === 'Escape' && box) box.hidden = true;
      });

      document.addEventListener('click', (e) => {
        if (box && !(e.target as HTMLElement).closest('.nav-search')) box.hidden = true;
      });
    </script>
  </body>
</html>
