---
// 全局布局：所有页面共用
import { siteConfig } from '../site.config';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '我的博客' } = Astro.props;
const siteTitle = siteConfig.siteTitle;

const nav = [
  { href: '/', label: '首页' },
  { href: '/essays/', label: '随笔' },
  { href: '/journal/', label: '事记' },
  { href: '/memo/', label: 'memo' },
  { href: '/about/', label: '关于' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path === '' : path.startsWith(href);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · {siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 字体：英文 Google Sans，中文思源黑体（正文）/ 思源宋体（标题）
         若 Google 字体加载失败，onerror 自动切换国内镜像 fonts.loli.net -->
    <link
      id="font-css"
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400..700&family=Noto+Sans+SC:wght@300..700&display=swap"
      onerror="this.onerror=null;this.href='https://fonts.loli.net/css2?family=Google+Sans:wght@400..700&family=Noto+Sans+SC:wght@300..700&display=swap';"
    />
    <link rel="stylesheet" href="/global.css" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <nav class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-text">{siteTitle}</span>
        </a>
        <div class="nav-links">
          {nav.map((item) => (
            <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
              {item.label}
            </a>
          ))}
        </div>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} {siteTitle} · 用心记录每一个瞬间</p>
      </div>
    </footer>
  </body>
</html>
