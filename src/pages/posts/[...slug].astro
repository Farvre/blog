---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig, categories } from '../../site.config';
import { postStats, fmtDate } from '../../lib/post-stats';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const stats = postStats(post.body);
const byline = `由 ${post.data.author} ${post.data.generated ? '生成' : '写'}`;
const cat = categories[post.data.category];
const walineServer = siteConfig.walineServerURL;
---

<Layout title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-header">
      <div class="post-meta">
        <span class="crumb">
          <a href="/">Home</a> {'<'} <a href={cat.path}>{cat.label}</a>
        </span>
        {post.data.pubDate && <span class="meta-sep">·</span>}
        {post.data.pubDate && <span class="date">{fmtDate(post.data.pubDate)}</span>}
        <span class="meta-sep">·</span>
        <span>{stats.minutes}min</span>
        <span class="meta-sep">·</span>
        <span>{stats.words.toLocaleString('zh-CN')} 字</span>
        <span class="meta-sep">·</span>
        <span>{byline}</span>
      </div>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="post-sub">{post.data.description}</p>}
    </header>

    {toc.length > 1 && (
      <details class="toc" open>
        <summary>目录</summary>
        <ul>
          {toc.map((h) => (
            <li class={`toc-depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </details>
    )}

    {post.data.cover && <img class="post-single-cover" src={post.data.cover} alt="" />}

    <div class="prose">
      <Content />
    </div>

    <!-- 点赞按钮 -->
    <div class="like-wrap" data-post-slug={post.id}>
      <button class="like-btn" id="like-btn" aria-label="点赞" onclick="toggleLike()">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 21s-7.5-4.7-10-9.3C.4 8.4 2.2 4.7 5.8 4.2c2-.3 3.8.6 4.9 2.1.6.8 1.1 1.2 1.3 1.4.2-.2.7-.6 1.3-1.4 1.1-1.5 2.9-2.4 4.9-2.1 3.6.5 5.4 4.2 3.8 7.5-2.5 4.6-10 9.3-10 9.3z"/>
        </svg>
        <span>点赞</span><span id="like-display">0</span>
      </button>
      <span class="like-count">点个赞支持一下～</span>
    </div>

    <!-- 评论：Waline（填个昵称就能评论，不用登录） -->
    <div id="comments">
      <h2>评论</h2>
      {walineServer ? (
        <div id="waline"></div>
      ) : (
        <p class="comment-note">评论区正在筹备中，稍后开放。</p>
      )}
    </div>
  </article>

  {walineServer && (
    <Fragment slot="head">
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@waline/client@3/dist/waline.css" />
    </Fragment>
  )}
</Layout>

<script define:vars={{ walineServer }} type="module">
  // ====== 点赞（存在浏览器本地） ======
  window.toggleLike = function () {
    const slug = document.querySelector('.like-wrap')?.dataset.postSlug;
    if (!slug) return;
    const KEY = 'liked_' + slug;
    const display = document.getElementById('like-display');
    const btn = document.getElementById('like-btn');
    const storageKey = 'like_count_' + slug;
    let count = parseInt(localStorage.getItem(storageKey) || '0', 10);
    if (localStorage.getItem(KEY)) {
      count = Math.max(0, count - 1);
      localStorage.removeItem(KEY);
      btn.classList.remove('liked');
    } else {
      count += 1;
      localStorage.setItem(KEY, '1');
      btn.classList.add('liked');
    }
    localStorage.setItem(storageKey, String(count));
    display.textContent = count;
  };
  (function initLike() {
    const display = document.getElementById('like-display');
    const btn = document.getElementById('like-btn');
    const slug = document.querySelector('.like-wrap')?.dataset.postSlug;
    if (!slug) return;
    display.textContent = parseInt(localStorage.getItem('like_count_' + slug) || '0', 10);
    if (localStorage.getItem('liked_' + slug)) btn.classList.add('liked');
  })();

  // ====== 评论（Waline） ======
  if (walineServer) {
    const { init } = await import('https://cdn.jsdelivr.net/npm/@waline/client@3/dist/waline.js');
    init({
      el: '#waline',
      serverURL: walineServer,
      lang: 'zh-CN',
      requiredMeta: ['nick'],
      meta: ['nick', 'mail', 'link'],
      pageview: true,
      comment: true,
    });
  }
</script>
